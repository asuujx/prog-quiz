<Window x:Class="quizini.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:quizini"
        xmlns:vm="clr-namespace:quizini.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel"/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Button Click="OpenReadFileDialog_Button" VerticalAlignment="Center" HorizontalAlignment="Center" Width="120" Height="40" Grid.Row="0" Background="#FFEAEAEA" Foreground="Black" BorderBrush="White">Wczytaj</Button>
            <Button Command="{Binding StartQuiz}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="120" Height="30" Grid.Row="1" Background="#FFEAEAEA" Foreground="Black" BorderBrush="White" Margin="0,0,0,15">Rozpocznij</Button>
            <TextBlock Text="{Binding TimerValue}" Grid.Column="1" Grid.Row="3" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding QuizName}" Grid.ColumnSpan="2" Grid.Row="0" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>

            <TextBlock Text="{Binding QuestionName}" Grid.ColumnSpan="2" Grid.Row="1" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>

            <Button Command="{Binding Button1Logic}" Content="{Binding Answers[0].Text}" Foreground="Black" BorderBrush="Transparent" Background="Transparent" Padding="10" Grid.ColumnSpan="2" Grid.Row="2" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"></Button>
            <Button Command="{Binding Button2Logic}" Content="{Binding Answers[1].Text}" Grid.ColumnSpan="2" Grid.Row="3" FontSize="24" HorizontalAlignment="Center" Foreground="Black" BorderBrush="Transparent" Background="Transparent" Padding="10" VerticalAlignment="Center"></Button>
            <Button Command="{Binding Button3Logic}" Content="{Binding Answers[2].Text}" Foreground="Black" BorderBrush="Transparent" Background="Transparent" Padding="10" Grid.ColumnSpan="2" Grid.Row="4" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"></Button>
            <Button Command="{Binding Button4Logic}" Content="{Binding Answers[3].Text}" Foreground="Black" BorderBrush="Transparent" Background="Transparent" Padding="10" Grid.ColumnSpan="2" Grid.Row="5" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"></Button>

            <TextBlock Text="{Binding TotalPoints}" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" Width="120" Height="30" Grid.Column="0" Grid.Row="6" FontSize="24"/>
            <TextBlock Text="{Binding MaximumPoints}" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" Width="120" Height="30" Grid.Column="1" Grid.Row="6" FontSize="24"/>
        </Grid>
    </Grid>
</Window>
